<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx.Core and BepInEx.PluginInfoProps are not published to nuget.org; they
  come from BepInEx's own feed. Without this file the plugin cannot restore at
  all, and says so as NU1101 ("No packages exist with this id in source(s):
  nuget.org") — which reads like a typo in the version rather than a missing
  feed. CI never caught it because CI does not build the plugin.

  The other three packages the plugin uses (HarmonyX,
  BepInEx.AssemblyPublicizer.MSBuild, Microsoft.NETFramework.ReferenceAssemblies)
  are on nuget.org, and only these two are not.

  <clear /> is deliberate: it makes a clone restore identically everywhere
  instead of depending on whatever sources happen to be configured on the
  machine, including the case where a fresh SDK install has none at all.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
